# Database (MongoDB)
DATABASE_URI=mongodb://localhost:27017/pokeori

# Payload CMS
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Email (Resend)
RESEND_API_KEY=re_replace-with-your-resend-api-key

# Google Gemini (optional, for AI features)
GEMINI_API_KEY=

# Redis (optional when using the local helper)
REDIS_URL=redis://localhost:6379

# Stable 32-byte base64 key shared by every production replica/build.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Trust these headers only when the origin is firewalled to the named proxy.
TRUST_CLOUDFLARE_PROXY=false
TRUST_PROXY_HEADERS=false

# Public application URL
NEXT_PUBLIC_APP_URL=https://localhost:3000

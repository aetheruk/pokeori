{
  "name": "pokeori",
  "version": "0.27.1",
  "description": "Pokeori field-journal adventure game",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "migrate:gym-chronicles-v2": "bun scripts/reset-gym-chronicles-v2.ts",
    "build": "bun --bun next build --turbopack",
    "build:standalone": "bun run build && cp -R public .next/standalone/public && mkdir -p .next/standalone/.next && cp -R .next/static .next/standalone/.next/static",
    "dev": "pkill redis-server || true; concurrently --kill-others -n redis,next -c blue,magenta \"./tools/redis-stable/src/redis-server\" \"bun --bun next dev --turbo --experimental-https\"",
    "devsafe": "rm -rf .next && bun --bun next dev --turbo --experimental-https",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "validate:data": "bun test tests/game-schema.test.ts tests/grid-tile-palettes.test.ts tests/data-references.test.ts tests/generated-data-integrity.test.ts tests/pokemon-form-exclusions.test.ts tests/requirements-semantics.test.ts tests/source-hygiene.test.ts tests/api-response.test.ts tests/rate-limiter.test.ts tests/endless-milestones.test.ts tests/research-input-validation.test.ts tests/battle-action-validation.test.ts tests/battle-item-effects.test.ts tests/pvp-power-state.test.ts tests/pvp-turn-engine.test.ts tests/pvp-turn-sync.test.ts tests/pve-turn-engine.test.ts tests/dev-game-data-tools.test.ts tests/gym-leader-chronicles.test.ts tests/chronicle-gameplay-balance.test.ts",
    "payload": "payload",
    "start": "bun .next/standalone/server.js",
    "start:https": "concurrently --kill-others -n app,https -c magenta,blue \"PORT=3001 HOSTNAME=127.0.0.1 bun .next/standalone/server.js\" \"caddy run --config ./Caddyfile\"",
    "test": "bun test",
    "test:int": "bun test",
    "test:e2e": "echo \"No e2e tests configured\"",
    "generate:game-data": "bun scripts/generate-game-data.mjs",
    "fetch:tcg": "bun scripts/fetch-tcg-data.mjs",
    "generate:tcg": "bun scripts/generate-tcg-modules.mjs",
    "generate:compact-manifests": "bun scripts/generate-compact-manifests.mjs",
    "migrate:user-state": "bun scripts/migrate-user-state-collections.ts",
    "migrate:game-activity-domains": "bun scripts/migrate-game-activity-domains.ts",
    "migrate:performance-indexes": "bun scripts/migrate-performance-indexes.ts",
    "sync:tcg-sprites": "bun scripts/sync-tcg-set-sprites.mjs",
    "fetch:pokemon": "bun scripts/fetch-pokemon-data.mjs",
    "generate:pokemon": "bun scripts/generate-pokemon-modules.mjs",
    "generate:evolutions": "bun scripts/generate-evolutions.mjs",
    "generate:mega-stones": "bun scripts/generate-mega-stones.mjs",
    "sync:pokemon-sprites": "bun scripts/sync-pokemon-sprites.mjs",
    "sync:item-sprites": "bun scripts/sync-item-sprites.mjs",
    "download:sprites": "bun scripts/sync-pokemon-sprites.mjs",
    "generate:data": "bun scripts/generate-data-entries.mjs",
    "generate:quizzes": "bun scripts/generate-quizzes.ts --start=256 --limit=10000",
    "review:chronicles": "bun scripts/preview-gym-leader-chronicles.ts",
    "clone:sprites": "bun scripts/sync-pokemon-sprites.mjs --prepare-source-only",
    "moves:assign-recommended-forms": "bun scripts/assign-tm-recommended-form-ids.ts",
    "deploy:production": "bash scripts/deploy-ghcr.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.9.1",
    "@payloadcms/db-mongodb": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@tailwindcss/postcss": "4.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/matter-js": "0.20.2",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "csv-parse": "7.0.2",
    "dotenv": "17.4.2",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "13.1.1",
    "graphql": "17.0.2",
    "ioredis": "6.0.0",
    "jose": "6.2.10",
    "lucide-react": "1.34.0",
    "matter-js": "0.20.0",
    "motion": "13.1.1",
    "next": "16.3.3",
    "next-themes": "0.4.6",
    "payload": "3.88.0",
    "postcss": "8.5.26",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "react-icons": "5.7.0",
    "react-intersection-observer": "11.0.1",
    "react-starfield": "1.0.3",
    "react-window": "2.3.0",
    "sharp": "0.35.4",
    "simplex-noise": "4.0.3",
    "sonner": "2.0.8",
    "swr": "2.5.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "use-sound": "5.0.0",
    "uuid": "14.0.2",
    "vaul": "1.1.2",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@next/bundle-analyzer": "16.3.3",
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "baseline-browser-mapping": "2.11.19",
    "concurrently": "10.0.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@6.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "trustedDependencies": [
    "sharp",
    "esbuild",
    "unrs-resolver"
  ],
  "private": false,
  "packageManager": "bun@1.4.0",
  "overrides": {
    "dompurify": "3.4.14",
    "nanoid": "3.3.18"
  }
}
